              "description": "",
              "args": {
                "kind": "any"
              },
              "result": {
                "kind": "any"
              },
              "side_effect": "idempotent_write"
            },
            {
              "name": "count",
              "description": "",
              "args": {
                "kind": "any"
              },
              "result": {
                "kind": "any"
              },
              "side_effect": "read_only"
            }
          ],
          "replay_policy": [],
          "sandboxes": [

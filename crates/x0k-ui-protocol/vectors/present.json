{
  "clause": "ui-interfaces §4",
  "check": "fixture.present",
  "about": "What an app does with a present before it shows anything. It checks the call's fingerprint against its state shape, the head the call names against its live state, and the state, after any merge patch, against the shape. Each is refused by name, and a call asking mark: false of an instance that is not a dev instance is refused as mark_required. The input is the offer, the app's live state, the spelling of its state shape and the call; the answer is {presents: <the state to show>} or {refused}. The live state's fingerprint is the shape's pin.",
  "vectors": [
    {
      "name": "a whole state that fits the shape is shown as given",
      "input": {
        "offer": {
          "app": "app",
          "instance": "1",
          "interfaces": [
            {
              "name": "ui/observe",
              "fingerprint": "f"
            },
            {
              "name": "ui/history",
              "fingerprint": "f"
            }
          ],
          "state_head": "s3",
          "history": {
            "oldest": 1,
            "newest": 3,
            "fixtures": true
          }
        },
        "live": {
          "value": {
            "count": 2,
            "title": "draft"
          },
          "head": "s3",
          "fingerprint": "53a0ce8ce5e01c10"
        },
        "shape": {
          "kind": "struct",
          "open": false,
          "fields": {
            "count": {
              "shape": {
                "kind": "int"
              }
            },
            "title": {
              "shape": {
                "kind": "text"
              },
              "presence": "optional"
            }
          }
        },
        "present": {
          "fixture": {
            "kind": "state",
            "state": {
              "count": 5
            }
          },
          "fingerprint": "53a0ce8ce5e01c10"
        }
      },
      "expect": {
        "presents": {
          "count": 5,
          "title": null
        }
      }
    },
